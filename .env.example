# Django settings
SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (leave empty for SQLite, set for PostgreSQL)
# DATABASE_URL=postgres://user:password@localhost:5432/fynbus_chronicle

# SQLite directory (only used when DATABASE_URL is empty)
# In Docker, set to /app/data for volume persistence
# SQLITE_DIR=/app/data

# Office 365 SSO Configuration (see docs/SSO_SETUP.md)
SSO_ENABLED=False
# The SSO app registration (falls back to MICROSOFT_CLIENT_ID/SECRET).
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
# Tenant GUID; required when SSO_ENABLED=True ("common" is refused).
MICROSOFT_TENANT_ID=
# SSO_ALLOWED_EMAIL_DOMAINS=fynbus.dk
# SSO_ALLOW_GUESTS=False
# SSO_AUTO_CREATE_USERS=True
# Microsoft sign-in only; passwords just for these break-glass usernames
# (their form: /accounts/login/?local=1). Needs SSO_ENABLED=True.
# SSO_ONLY=False
# SSO_BREAK_GLASS_USERS=
# How long a login lasts, in hours (Django default: 336 = two weeks).
# SESSION_MAX_HOURS=336
# MS Planner board (docs/PLANNER.md). Secret and private key: sync container only.
# PLANNER_ENABLED=False
# PLANNER_SYNC_ENABLED=False
# PLANNER_CLIENT_ID=
# PLANNER_CLIENT_SECRET=
# PLANNER_PLAN_ID=
# PLANNER_SERVICE_ACCOUNT=
# PLANNER_PUBLIC_KEY=
# PLANNER_PRIVATE_KEY=
# PLANNER_WORK_HOURS=mon-fri 07:15-17:30
# PLANNER_INTERVAL_WORK=120
# PLANNER_INTERVAL_OFF=900
# Shared app for Graph mail (EMAIL_USE_GRAPH).
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Email Configuration
EMAIL_USE_GRAPH=False
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=it@fynbus.dk
CHRONICLE_EMAIL_RECIPIENTS=

# Security settings (for production)
CSRF_TRUSTED_ORIGINS=
SECURE_SSL_REDIRECT=False

# ServiceDesk Plus Integration
SERVICEDESK_URL=https://servicedesk.fynbus.dk
SERVICEDESK_API_KEY=
SERVICEDESK_SYNC_ENABLED=False
SERVICEDESK_SYNC_INTERVAL=300
