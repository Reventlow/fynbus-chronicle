# FynBus Chronicle Development Dockerfile

# Node.js for Tailwind comes from the official Node image, copied in below.
# This replaces piping the NodeSource setup script into a root shell, which
# ran whatever that URL served at build time.
FROM node:20-bookworm-slim AS node

FROM python:3.12-slim

# Set environment variables
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    DJANGO_SETTINGS_MODULE=chronicle.settings.dev

WORKDIR /app

# Install system dependencies for WeasyPrint
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libpango-1.0-0 \
    libpangocairo-1.0-0 \
    libgdk-pixbuf-2.0-0 \
    libffi-dev \
    shared-mime-info \
    fonts-liberation \
    && rm -rf /var/lib/apt/lists/*

# Install Node.js for Tailwind (binary + bundled npm from the node stage)
COPY --from=node /usr/local/bin/node /usr/local/bin/node
COPY --from=node /usr/local/lib/node_modules /usr/local/lib/node_modules
RUN ln -s ../lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
    && ln -s ../lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx

# Install Python dependencies from the hash-pinned lock (see requirements/lock/)
COPY requirements/lock/requirements-dev.txt ./requirements/lock/
RUN pip install --no-cache-dir --require-hashes -r requirements/lock/requirements-dev.txt

# Install Node dependencies exactly as package-lock.json lists them
COPY package.json package-lock.json ./
RUN npm ci

# Copy application code
COPY . .

# Create non-root user
RUN useradd -m -u 1000 chronicle && \
    chown -R chronicle:chronicle /app

USER chronicle

EXPOSE 8000

CMD ["python", "manage.py", "runserver", "0.0.0.0:8000"]
